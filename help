MODO=extremo TARGET_URL=https://10.33.195.185 HOST_HEADER=cms.tas10.local k6 run ~/Develop/TAS_10/config/pruebas/k6-ataque-saturacion.js

# Test Respaldos

//En nfs

	ls -lh /backups/db/ /backups/wp_files/  # ver los respaldos
	sudo crontab -l. 		#Para ver cron de respaldo O

// Comprobar que los respaldos no están corruptos
	ULTIMO=$(ls -1t /backups/db/ | head -n1)
        gzip -t /backups/db/$ULTIMO && echo "OK"
        sha256sum /backups/db/$ULTIMO

// borrar wordpress_eval si existe 
	mariadb -h 10.33.199.85 -P 7033 -u tas_cms -ptas_10 -e "DROP DATABASE IF EXISTS wordpress_eval; SHOW DATABASES;" 

// crear la e inyectarle el respaldo
	time (mariadb -h 10.33.199.85 -P 7033 -u tas_cms -ptas_10 -e "CREATE DATABASE wordpress_eval;" && gunzip -c /backups/db/$ULTIMO | mariadb -h 10.33.199.85 -P 7033 -u tas_cms -ptas_10 wordpress_eval)

